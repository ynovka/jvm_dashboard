  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jvm_session"
      }
    },
    "schemas": {
      "Spec": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "jdk": {
            "type": "integer",
            "enum": [
              8,
              11,
              17,
              21,
              25
            ]
          },
          "cpu": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 64,
            "description": "vCPU (1 = quota of one logical core)"
          },
          "memoryMiB": {
            "type": "integer",
            "minimum": 256,
            "maximum": 262144
          },
          "diskMiB": {
            "type": "integer",
            "minimum": 128,
            "maximum": 1048576
          },
          "jar": {
            "type": "string",
            "description": "Relative .jar path; no traversal, symlinks or panel internals"
          },
          "jvmArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "appArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Env"
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Port"
            }
          },
          "autostart": {
            "type": "boolean"
          },
          "crashRestart": {
            "type": "boolean"
          },
          "stopSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "healthPort": {
            "type": [
              "integer",
              "null"
            ]
          },
          "image": {
            "type": "string",
            "description": "Server resolves and pins this field; users cannot supply Docker settings"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "Env": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "description": "Masked to empty string for stored secret; empty PATCH preserves existing secret"
          },
          "secret": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "Port": {
        "type": "object",
        "properties": {
          "host": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 60000
          },
          "container": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "public": {
            "type": "boolean"
          }
        },
        "required": [
          "host",
          "container"
        ],
        "additionalProperties": false
      },
      "Register": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "token"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "CreateApplication": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/Spec"
          }
        },
        "required": [
          "workspaceId",
          "spec"
        ],
        "additionalProperties": false
      },
      "UpdateApplication": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "spec": {
            "$ref": "#/components/schemas/Spec"
          }
        },
        "required": [
          "revision",
          "spec"
        ],
        "additionalProperties": false
      },
      "Invite": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "OPERATOR",
              "VIEWER"
            ]
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cpu": {
            "type": "number"
          },
          "memory_mib": {
            "type": "integer"
          },
          "disk_mib": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "cpu",
          "memory_mib",
          "disk_mib"
        ],
        "additionalProperties": false
      },
      "Membership": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "OPERATOR",
              "VIEWER"
            ]
          },
          "appIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "role",
          "appIds"
        ],
        "additionalProperties": false
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": "boolean"
          }
        },
        "required": [
          "disabled"
        ],
        "additionalProperties": false
      },
      "FileAction": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "read",
              "write",
              "mkdir",
              "rename",
              "copy",
              "move",
              "trash",
              "trashList",
              "restore",
              "uploadStart",
              "uploadChunk",
              "uploadStatus",
              "uploadFinish",
              "uploadCancel",
              "download",
              "archive",
              "extract"
            ]
          },
          "path": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "etag": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "metadataOnly": {
            "type": "boolean"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "FirewallAction": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "status",
              "add",
              "remove",
              "removeExternal",
              "toggle",
              "confirm",
              "rollback"
            ]
          },
          "generation": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "port": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "fieldErrors",
          "requestId"
        ],
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "result": {
            "type": [
              "string",
              "null"
            ]
          },
          "created": {
            "type": "integer",
            "description": "UTC epoch milliseconds"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": true
      }
    }
  }
}
